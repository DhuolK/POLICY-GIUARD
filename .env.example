FLASK_ENV=development
# Generate a random value for local development; never commit a real secret.
SECRET_KEY=
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=policy_guard

# ── Customer SMS reminders (Africa's Talking) ──────────────────────────
# Leave AT_API_KEY blank (or set SMS_SIMULATE=1) for safe simulated sends.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_SIMULATE=1
