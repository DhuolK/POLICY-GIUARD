FLASK_ENV=development
# Generate a random value for local development; never commit a real secret.
SECRET_KEY=
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=policy_guard
# Fail fast (5s) if Mongo is unreachable instead of pymongo's 30s default hang.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ── Login throttling (per client IP, see docs/SECURITY_AUDIT_cyberskills.md) ──
# Budget for POST /login. Only FAILED attempts consume it, so a shared office
# IP can sign in all day while a spraying script runs out of attempts. Raise
# this if everyone shares one NAT'd public IP.
LOGIN_RATE_LIMIT=10 per 5 minutes
# Counters are stored in MongoDB (no Redis on shared hosting). Left blank to
# reuse MONGO_URI/MONGO_DB_NAME; override only if you want a separate database:
#   RATELIMIT_STORAGE_URI=mongodb+srv://...
#   RATELIMIT_DATABASE_NAME=policy_guard_limits
RATELIMIT_STORAGE_URI=
RATELIMIT_DATABASE_NAME=

# ── Customer SMS reminders (Africa's Talking) ──────────────────────────
# Leave AT_API_KEY blank (or set SMS_SIMULATE=1) for safe simulated sends.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_SIMULATE=1
# Scheduler: loop interval for scripts/sms_scheduler.py (or run
# `flask sms-tick` from cron / Windows Task Scheduler every minute).
SMS_DRAIN_INTERVAL_SEC=60
# AT dashboard callbacks (public HTTPS base of this app):
#   DLR:      https://policyguard.co.ke/sms/dlr
#   Inbound:  https://policyguard.co.ke/sms/inbound
# Engine politeness/reliability knobs (quiet hours, frequency cap, retry
# budget, per-segment KES rate) live in the `app_settings` sms_engine doc
# and are tunable at runtime — no redeploy needed.

# ── M-Pesa C2B Paybill (Safaricom Daraja) ─────────────────────────────
# STK push is retired; money arrives via customer-initiated Paybill (C2B).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Public HTTPS base of this app; confirm/validate URLs derive from it.
APP_BASE_URL=https://policyguard.co.ke
MPESA_C2B_CONFIRM_URL=https://policyguard.co.ke/payments/c2b/confirm
MPESA_C2B_VALIDATE_URL=https://policyguard.co.ke/payments/c2b/validate

# ── Webhook source-IP allowlists ───────────────────────────────────────
# C2B callbacks are unsigned POSTs to a public URL: without this, anyone who
# learns the URL can forge a confirmation and mint a payment. Production with
# MPESA_ENV=production refuses to boot until MPESA_CALLBACK_ALLOWED_IPS is set.
# Deliberately left unset here so local/dev callbacks (localhost, ngrok) work;
# set it for real deployments. The values below are COMMUNITY-DOCUMENTED
# Safaricom egress ranges (not served by the Daraja API) — confirm them with
# Safaricom support or your own production logs before relying on them.
#   MPESA_CALLBACK_ALLOWED_IPS=196.201.212.0/24,196.201.213.0/24,196.201.214.0/24
MPESA_CALLBACK_ALLOWED_IPS=
# Africa's Talking DLR/inbound callbacks. Optional: blank accepts any source
# (a forged DLR only misreports SMS status; no money moves).
SMS_CALLBACK_ALLOWED_IPS=

